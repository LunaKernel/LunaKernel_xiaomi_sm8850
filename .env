# Block the stock same-name module; the built-in Rust Binder is unaffected.
LUNA_MODULE_BLACKLIST=rust_binder
# SM8850 ISA declarations with an Oryon-1 scheduling proxy.
# Kbuild owns SIMD and branch protection; Rust must end in -neon.
SM8850_C_ARCH=armv9.1-a+fp16fml+crypto+sve2-aes+sve2-sha3+sve2-sm4+sme+rcpc3+rng
SM8850_TUNE_CPU=oryon-1
SM8850_RUST_FEATURES='+neon,+fp16,+fhm,+rdm,+dotprod,+fcma,+jsconv,+frintts,+bf16,+i8mm,+aes,+sha2,+sha3,+sm4,+crc,+lse,+lse2,+rcpc,+rcpc2,+rcpc3,+dit,+flagm,+flagm2,+dpb,+dpb2,+paca,+pacg,+rand,+sb,+ssbs,+bti,+ecv,+sve,+sve2,+sve2-aes,+sve2-sha3,+sve2-sm4,+sme,-strict-align,-neon'
# Apply ExtTSP only to functions carrying profile data; keep unprofiled layout.
KERNEL_EXTTSP_LLVM_FLAGS='-enable-ext-tsp-block-placement=true -ext-tsp-apply-without-profile=false'
# Keep Profi, using path augmentation to avoid the observed uniform-flow DAG slowdown.
KERNEL_AUTOFDO_LLVM_FLAGS='-sample-profile-even-flow-distribution=false'
# Parallelize only core's frontend, retaining Kbuild's jobserver and one CGU.
RUST_CORE_THREADS=4
