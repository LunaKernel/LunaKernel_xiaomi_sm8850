# Xiaomi's published soc-repo still records this older ACK pin. Keep it as a
# baseline-integrity check, but do not use it for the replacement GKI Image:
# the known-bootable Image is based on the later AOSP r57 tree and needs its
# additional Android vendor hooks/KMI exports.
XIAOMI_ACK_BRANCH=android16-6.12-2025-06_r8
XIAOMI_ACK_COMMIT=f1bdb13583da85a47fcf1632a78ef52d6e6da651

