# Shared shell variables for init.sh, patch.sh, patch_external.sh and build.sh.
# Values must use shell syntax: KEY=value, with no spaces around "=".

# Optional OrbStack Linux machine name. Leave empty to use OrbStack's default.
ORB_MACHINE=xiaomi-build

# Linux-side workspace root, relative to the Orb user's home directory.
ORB_LINUX_ROOT=.cache/xiaomi_kernel_build

# Xiaomi official SoC repository. This remains separate from GKI common.
KERNEL_REPO=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
KERNEL_BRANCH=popsicle-w-oss
KERNEL_COMMIT=45705be1220b4cfa8100516ad86711656c0b634e
SOC_SOURCE_DIR=sources/xiaomi_sm8850_soc

# Official AOSP Android 16 GKI common with KMI generation 6, selected for the
# Xiaomi 17 Android 17 vendor-module ABI. The release branch, commit and path are
# independent from the Android 16 production branch.
COMMON_REPO=https://android.googlesource.com/kernel/common
COMMON_BRANCH=android16-6.12-2026-09_r11
COMMON_VERSION=6.12.92
COMMON_COMMIT=aa556307b679df7ced0cc644068a529280dbc412
COMMON_SOURCE_DIR=sources/aosp_common_6.12.92_kmi6_2026-09
AOSP_AUTOFDO_PROFILE_RELATIVE_PATH=gki/aarch64/afdo/kernel.afdo
