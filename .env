# Shared shell variables for init.sh, patch.sh, patch_external.sh and build.sh.
# Values must use shell syntax: KEY=value, with no spaces around "=".

# Optional OrbStack Linux machine name. Leave empty to use OrbStack's default.
ORB_MACHINE=xiaomi-build

# Linux-side workspace root, relative to the Orb user's home directory.
ORB_LINUX_ROOT=.cache/xiaomi_kernel_build

# Xiaomi official SoC repository. This remains separate from GKI common.
KERNEL_REPO=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
KERNEL_BRANCH=popsicle-w-oss
KERNEL_COMMIT=45705be1220b4cfa8100516ad86711656c0b634e
SOC_SOURCE_DIR=sources/xiaomi_sm8850_soc

# Official AOSP Android 16 GKI common matching the known-bootable Image lineage.
COMMON_REPO=https://android.googlesource.com/kernel/common
COMMON_BRANCH=android16-6.12-2025-06_r57
COMMON_COMMIT=a82fc641d6d2c687802606190c0a8c33a4242201
COMMON_SOURCE_DIR=sources/aosp_common_6.12.23_r57

# Official KernelSU stage-2 source. Keep the stable release tag and immutable
# commit together; init.sh verifies both before patch_external.sh integrates it.
ENABLE_KERNELSU=1
KSU_REPO=https://github.com/tiann/KernelSU.git
KSU_REF=v3.2.5
KSU_COMMIT=b0bc817b4e966aa6aa830834eaf6ef765d821d40
KSU_SOURCE_DIR=sources/kernelsu
KSU_INTEGRATION_MODE=builtin
KSU_GIT_VERSION_COUNT=2525
KSU_VERSION_CODE=32525
KSU_ENHANCED_SECURITY_REMOVAL_COMMIT=1b6e2ed6b38dad1c8af90402a82ed2f752b05cfa
KSU_MANAGER_APK=KernelSU_v3.2.5_32525-release.apk
KSU_MANAGER_URL=https://github.com/tiann/KernelSU/releases/download/v3.2.5/KernelSU_v3.2.5_32525-release.apk
KSU_MANAGER_SHA256=1417081413bf7ab1de8e440ecbcb62685037c8f28f048f0f8b79e305b31ab916

# Official SUSFS stage-3 source. The Android 16/6.12 branch has no matching
# release tag, so pin its reviewed branch head instead of following it loosely.
ENABLE_SUSFS=1
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_REF=gki-android16-6.12
SUSFS_COMMIT=d9a486dc7197800149c31fe35a77997ea0ddaa83
SUSFS_SOURCE_DIR=sources/susfs4ksu
SUSFS_KSU_PATCH_COMMIT=ef69c8322232340f43c78c7fc491b32cb9f7da86
SUSFS_HELPER_SHA256=dfa9a11f45c2978789175c3ad15290a831639248d159c34980e27c36f92b833c

# Official Baseband Guard stage-4 source. Pin the reviewed main commit that
# switched to the modern disk API and fixed the previous bypass/deadlock path.
ENABLE_BBG=1
BBG_REPO=https://github.com/vc-teahouse/Baseband-guard.git
BBG_REF=main
BBG_COMMIT=1c664957da7539de860503940ee73c7447f1dfaf
BBG_SOURCE_DIR=sources/baseband_guard
ENABLE_STAGE4_FS=1

# Official ADIOS stage-5 source. The stable patch targets Linux 6.12.44 and is
# applied to the pinned 6.12.23 AOSP tree with one reviewed Kbuild adaptation.
# Keep the upstream force-default patch pinned only to prove it is absent:
# Xiaomi's multiqueue baseline must continue to start with the "none" scheduler.
ENABLE_ADIOS=1
ADIOS_REPO=https://github.com/firelzrd/adios.git
ADIOS_REF=main
ADIOS_COMMIT=08bf078aac99075a0bef73c2b2497574a82e4c41
ADIOS_SOURCE_DIR=sources/adios
ADIOS_STABLE_PATCH=patches/stable/0001-linux6.12.44-ADIOS-3.2.0.patch
ADIOS_FORCE_DEFAULT_PATCH=patches/0002-Make-ADIOS-the-Default-I-O-scheduler.patch

# Official TCP Brutal source. It is built into Image but never selected as the
# system default; supported userspace may opt in through TCP_CONGESTION.
ENABLE_TCP_BRUTAL=1
TCP_BRUTAL_REPO=https://github.com/apernet/tcp-brutal.git
TCP_BRUTAL_REF=master
TCP_BRUTAL_COMMIT=f11e52d88c7ad2285896de018c2d96d4687f0ab6
TCP_BRUTAL_SOURCE_DIR=sources/tcp_brutal
TCP_BRUTAL_SOURCE_SHA256=171d775cc494f9378c89772ef68ad8001e093f701a35d1566ec9c7e459cb81c0

# Stage-5 selected configuration matrix.
ENABLE_STAGE5_NAMESPACES=1
ENABLE_STAGE5_NETWORK=1

# Read-only post-r57 audit inputs. These refs are discovery material only:
# they MUST NOT replace COMMON_COMMIT or be checked out over the build tree.
ENABLE_BACKPORT_AUDIT=1
BACKPORT_AUDIT_SNAPSHOT=2026-07-24
AOSP_BACKPORT_AUDIT_SOURCE_DIR=sources/aosp_common_backport_audit
AOSP_BACKPORT_AUDIT_REFS='android16-6.12-2025-07:0a132520574c9f3530effc59e257add27d6f51d3 android16-6.12-2025-08:66d1df7d77519381eb34e51ff23f79f89778152e android16-6.12-2025-09:a467d0ca29d881737221425f379d32f14ff9a97e android16-6.12-2025-12:bb67b4dad3fb9473cad18545ea18cbaea136e7ce android16-6.12-2026-03:202a62288cb6884f0bdcea8a8d47a1a8c4d3e143 android16-6.12-2026-06:fff5a9d1fc286471688fe85cafb5726a0e3c4abd android16-6.12-lts:9cf86beb14562d97f14e0d80bbfdf1c5420a93d2 android16-6.12:41c3d4eb44a78d5e5ec9dbcbaff1a383edd77212 android16-6.12-sp:5c5f2fea42dd4cc5ae1002945d86e305c09d3262 android16-6.12-desktop:b03934ac487e89b4c77ed7755bda42f010560ed1 android16-6.12-desktop-bluey:d9bb8c2c71e58fc370c7c5437a0e058361602981 android16-6.12-desktop-cl-dispatcher:ee35fccb8f791fddb8ff780e0b1adff5d17945f2 android16-6.12-kminext:d3e42975deca0d4821843e116bf6da685fd9c7cb android-mainline:7b944e55b56b8a9033ce2a82b3205b17603943af'
LINUX_STABLE_AUDIT_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
LINUX_STABLE_AUDIT_REF=linux-6.12.y
LINUX_STABLE_AUDIT_BASE_COMMIT=83b4161a63b87ce40d9f24f09b5b006f63d95b7c
LINUX_STABLE_AUDIT_COMMIT=6d15a1029d425b15c59463910ebdccc4afe760d6
