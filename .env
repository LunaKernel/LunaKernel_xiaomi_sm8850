# Stage-5 supplementary hardening. Keep Google's upstream commit as the
# semantic reference, but use a reviewed 6.12.23 adaptation: the original
# change was reverted on Android because it invalidated existing casefold
# directory hashes, so this project also supplies ext4/f2fs lookup fallback
# and regression vectors.
ENABLE_UNICODE_IGNORABLE_FIX=1
