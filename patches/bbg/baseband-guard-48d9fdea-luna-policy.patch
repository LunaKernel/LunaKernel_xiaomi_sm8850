+static bool is_zram_block_device(const struct block_device *bdev)
+{
+	return bdev && bdev->bd_disk &&
+	       !strncmp(bdev->bd_disk->disk_name, "zram", strlen("zram"));
+}
+
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 11, 0) || defined(BBG_COMPAT_HAS_BLOCK_DEVICE_API)
 
 /*
@@ -96,11 +102,26 @@ static bool partition_name_in_allowlist(const char *name, size_t max_len)
  *   -> bd_meta_info
  *   -> volname
  */
+bool is_allowed_block_device(const struct block_device *bdev)
+{
+	const struct partition_meta_info *info;
+
+	if (!bdev)
+		return false;
+	if (is_zram_block_device(bdev))
+		return true;
+
+	info = READ_ONCE(bdev->bd_meta_info);
+	if (!info)
+		return false;
+	return partition_name_in_allowlist((const char *)info->volname,
+					   sizeof(info->volname));
+}
+
 bool is_allowed_partition_dev_resolve(dev_t dev)
 {
 	struct block_device *bdev;
-	const struct partition_meta_info *info;
-	bool allowed = false;
+	bool allowed;
 
 	if (!dev)
 		return false;
@@ -113,13 +134,7 @@ bool is_allowed_partition_dev_resolve(dev_t dev)
 	if (IS_ERR_OR_NULL(bdev))
 		return false;
 
-	info = READ_ONCE(bdev->bd_meta_info);
-	if (info) {
-		allowed = partition_name_in_allowlist(
-			(const char *)info->volname,
-			sizeof(info->volname));
-	}
-
+	allowed = is_allowed_block_device(bdev);
 	blkdev_put_no_open(bdev);
 	return allowed;
 }
