diff --git a/block/bsg.c b/block/bsg.c
--- a/block/bsg.c
+++ b/block/bsg.c
@@ -12,6 +12,8 @@
 #include <linux/idr.h>
 #include <linux/bsg.h>
 #include <linux/slab.h>
+#include <linux/baseband_guard.h>
+#include <linux/string.h>
 
 #include <scsi/scsi.h>
 #include <scsi/scsi_ioctl.h>
@@ -35,6 +37,20 @@ static inline struct bsg_device *to_bsg_device(struct inode *inode)
 	return container_of(inode->i_cdev, struct bsg_device, cdev);
 }
 
+static bool bsg_is_ufs_endpoint(const struct bsg_device *bd)
+{
+	const char *name;
+
+	if (!bd->device.parent)
+		return false;
+	/* UFS registers this parent in ufs_bsg_probe(), not through a devnode. */
+	name = dev_name(bd->device.parent);
+	if (!str_has_prefix(name, "ufs-bsg"))
+		return false;
+	name += strlen("ufs-bsg");
+	return *name && strspn(name, "0123456789") == strlen(name);
+}
+
 #define BSG_DEFAULT_CMDS	64
 #define BSG_MAX_DEVS		(1 << MINORBITS)
 
@@ -148,6 +164,11 @@ static long bsg_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 	case SG_EMULATED_HOST:
 		return put_user(1, intp);
 	case SG_IO:
+		if (bsg_is_ufs_endpoint(bd)) {
+			val = bbg_ufs_bsg_permission(file);
+			if (val)
+				return val;
+		}
 		return bsg_sg_io(bd, file->f_mode & FMODE_WRITE, uarg);
 	case SCSI_IOCTL_SEND_COMMAND:
 		pr_warn_ratelimited("%s: calling unsupported SCSI_IOCTL_SEND_COMMAND\n",
diff --git a/drivers/scsi/scsi_ioctl.c b/drivers/scsi/scsi_ioctl.c
--- a/drivers/scsi/scsi_ioctl.c
+++ b/drivers/scsi/scsi_ioctl.c
@@ -6,6 +6,7 @@
  *   for the ones that remain
  */
 #include <linux/module.h>
+#include <linux/baseband_guard.h>
 #include <linux/blkdev.h>
 #include <linux/interrupt.h>
 #include <linux/errno.h>
@@ -250,9 +251,15 @@
  */
 bool scsi_cmd_allowed(unsigned char *cmd, bool open_for_write)
 {
-	/* root can do any command. */
-	if (capable(CAP_SYS_RAWIO))
+	/* BBG-restricted credentials must also follow the command allowlist. */
+	if (capable(CAP_SYS_RAWIO) && bbg_rawio_trusted())
 		return true;
 
+	/* Optical read opcodes alias disk UNMAP, SANITIZE and MAINTENANCE_OUT. */
+	if (!bbg_rawio_trusted() &&
+	    (cmd[0] == UNMAP || cmd[0] == GPCMD_PLAY_AUDIO_TI ||
+	     cmd[0] == MAINTENANCE_OUT))
+		return false;
+
 	/* Anybody who can open the device can do a read-safe command */
 	switch (cmd[0]) {
@@ -338,7 +345,7 @@ bool scsi_cmd_allowed(unsigned char *cmd, bool open_for_write)
 	case GPCMD_SET_READ_AHEAD:
 	/* ZBC */
 	case ZBC_OUT:
-		return open_for_write;
+		return open_for_write && bbg_rawio_trusted();
 	default:
 		return false;
 	}
diff --git a/include/linux/baseband_guard.h b/include/linux/baseband_guard.h
new file mode 100644
--- /dev/null
+++ b/include/linux/baseband_guard.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_BASEBAND_GUARD_H
+#define _LINUX_BASEBAND_GUARD_H
+
+struct cred;
+struct file;
+
+#if IS_ENABLED(CONFIG_BBG)
+void bbg_mark_untrusted_cred(struct cred *cred);
+bool bbg_rawio_trusted(void);
+int bbg_ufs_bsg_permission(struct file *file);
+#else
+static inline void bbg_mark_untrusted_cred(struct cred *cred) { }
+static inline bool bbg_rawio_trusted(void) { return true; }
+static inline int bbg_ufs_bsg_permission(struct file *file) { return 0; }
+#endif
+
+#endif /* _LINUX_BASEBAND_GUARD_H */
