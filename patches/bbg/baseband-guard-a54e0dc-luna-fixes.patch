+#ifdef CONFIG_IO_URING
+static int bb_uring_cmd(struct io_uring_cmd *ioucmd)
+{
+	struct file *file;
+	struct inode *inode;
+
+	if (likely(current_process_trusted()) || !ioucmd)
+		return 0;
+
+	file = ioucmd->file;
+	inode = bbg_block_inode(file);
+	if (!inode || ioucmd->cmd_op != BLOCK_URING_CMD_DISCARD)
+		return 0;
+	if (bbg_file_allowed(file))
+		return 0;
+
+	return deny("io_uring discard on protected partition", inode,
+		    ioucmd->cmd_op);
+}
+#endif
+
+static int bb_mmap_file(struct file *file, unsigned long reqprot,
+			unsigned long prot, unsigned long flags)
+{
+	struct inode *inode;
+
+	if (likely(current_process_trusted()) || !(prot & PROT_WRITE) ||
+	    !(flags & MAP_SHARED))
+		return 0;
+
+	inode = bbg_block_inode(file);
+	if (!inode || bbg_file_allowed(file))
+		return 0;
+
+	return deny("shared writable mmap of protected partition", inode, 0);
+}
+
+static int bb_file_mprotect(struct vm_area_struct *vma,
+			    unsigned long reqprot, unsigned long prot)
+{
+	struct file *file;
+	struct inode *inode;
+
+	if (likely(current_process_trusted()) || !vma ||
+	    !(prot & PROT_WRITE) || !(vma->vm_flags & VM_SHARED))
+		return 0;
+
+	file = vma->vm_file;
+	inode = bbg_block_inode(file);
+	if (!inode || bbg_file_allowed(file))
+		return 0;
+
+	return deny("writable mprotect of protected partition", inode, 0);
+}
