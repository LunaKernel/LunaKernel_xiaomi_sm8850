+	{ 0xffa0, 0xffa0 }, { 0xfff0, 0xfff8 },
+	{ 0x1bca0, 0x1bca3 }, { 0x1d173, 0x1d17a },
+	{ 0xe0000, 0xe0000 }, { 0xe0001, 0xe0001 },
+	{ 0xe0002, 0xe001f }, { 0xe0020, 0xe007f },
+	{ 0xe0080, 0xe00ff }, { 0xe0100, 0xe01ef },
+	{ 0xe01f0, 0xe0fff },
+};
+
+static int encode_utf8_codepoint(unsigned int cp, unsigned char out[5])
+{
+	int len;
+
+	if (cp <= 0x7f) {
+		out[0] = cp;
+		len = 1;
+	} else if (cp <= 0x7ff) {
+		out[0] = 0xc0 | (cp >> 6);
+		out[1] = 0x80 | (cp & 0x3f);
+		len = 2;
+	} else if (cp <= 0xffff) {
+		out[0] = 0xe0 | (cp >> 12);
+		out[1] = 0x80 | ((cp >> 6) & 0x3f);
+		out[2] = 0x80 | (cp & 0x3f);
+		len = 3;
+	} else {
+		out[0] = 0xf0 | (cp >> 18);
+		out[1] = 0x80 | ((cp >> 12) & 0x3f);
+		out[2] = 0x80 | ((cp >> 6) & 0x3f);
+		out[3] = 0x80 | (cp & 0x3f);
+		len = 4;
+	}
+	out[len] = 0;
+	return len;
+}
+
+static void check_default_ignorable_form(struct unicode_map *um,
+		enum utf8_normalization n, unsigned int cp)
+{
+	unsigned char input[7] = { 'A' };
+	unsigned char expected[7] = { 0 };
+	struct utf8cursor cursor;
+	int cp_len, input_len, ret, i;
+
+	cp_len = encode_utf8_codepoint(cp, input + 1);
+	input[cp_len + 1] = 'B';
+	input_len = cp_len + 2;
+	input[input_len] = 0;
+
+	memcpy(expected, input, input_len + 1);
+	if (n == UTF8_NFDICF) {
+		expected[0] = 'a';
+		expected[input_len - 1] = 'b';
+	}
+
+	test_f((utf8nlen(um, n, input, input_len) == input_len),
+	       "U+%06X bounded length mismatch in form %d\n", cp, n);
+	test_f((utf8nlen(um, n, input, (size_t)-1) == input_len),
+	       "U+%06X unbounded length mismatch in form %d\n", cp, n);
+
+	ret = utf8ncursor(&cursor, um, n, input, input_len);
+	test_f((ret == 0), "U+%06X cursor creation failed in form %d\n", cp, n);
+	if (ret)
+		return;
+
+	for (i = 0; i < input_len; i++) {
+		ret = utf8byte(&cursor);
+		test_f((ret == expected[i]),
+		       "U+%06X byte %d was 0x%x, expected 0x%x in form %d\n",
+		       cp, i, ret, expected[i], n);
+	}
+	ret = utf8byte(&cursor);
+	test_f((ret == 0), "U+%06X did not terminate in form %d: %d\n",
+	       cp, n, ret);
+}
+
+static void check_utf8_default_ignorables(struct unicode_map *um)
+{
+	static const unsigned char folded_without_ignorable[] = "ab";
+	unsigned int range, cp, checked = 0;
+
+	for (range = 0; range < ARRAY_SIZE(default_ignorable_ranges); range++) {
+		for (cp = default_ignorable_ranges[range].first;
+		     cp <= default_ignorable_ranges[range].last; cp++) {
+			unsigned char wrapped[7] = { 'A' };
+			int cp_len = encode_utf8_codepoint(cp, wrapped + 1);
+			struct qstr with_ignorable;
+			struct qstr without_ignorable;
+
+			wrapped[cp_len + 1] = 'B';
+			with_ignorable.name = wrapped;
+			with_ignorable.len = cp_len + 2;
+			without_ignorable.name = folded_without_ignorable;
+			without_ignorable.len = 2;
+
+			check_default_ignorable_form(um, UTF8_NFDI, cp);
+			check_default_ignorable_form(um, UTF8_NFDICF, cp);
+			test_f((utf8_strncasecmp(um, &with_ignorable,
+					        &without_ignorable) != 0),
+			       "U+%06X collapsed out of a casefolded name\n", cp);
+			checked++;
+		}
+	}
+
+	test_f((checked == 4173), "tested %u Default-Ignorable code points\n",
+	       checked);
+}
