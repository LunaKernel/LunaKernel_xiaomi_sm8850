+struct utf8_codepoint_range {
+	unsigned int first;
+	unsigned int last;
+};
+
+/* DerivedCoreProperties.txt from the pinned Unicode 12.1.0 UCD. */
+static const struct utf8_codepoint_range default_ignorable_ranges[] = {
+	{ 0x00ad, 0x00ad }, { 0x034f, 0x034f }, { 0x061c, 0x061c },
+	{ 0x115f, 0x1160 }, { 0x17b4, 0x17b5 }, { 0x180b, 0x180d },
+	{ 0x180e, 0x180e }, { 0x200b, 0x200f }, { 0x202a, 0x202e },
